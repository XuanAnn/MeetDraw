{
  "name": "meetdraw",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time web video conferencing and collaborative whiteboard using Client-Server + WebRTC P2P Mesh",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:shared": "npm run build --workspace=shared -- --watch",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:shared": "npm run build --workspace=shared",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "start:server": "node server/dist/server.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "vercel": "^59.15.1"
  }
}
